<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/feature_game_level_select_continue_radius" />
            <solid android:color="@color/feature_game_level_select_mint_pressed" />
            <stroke android:width="3dp" android:color="@color/feature_game_level_select_cream" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/feature_game_level_select_continue_radius" />
            <solid android:color="@color/feature_game_level_select_mint_deep" />
            <stroke android:width="3dp" android:color="@color/feature_game_level_select_cream" />
        </shape>
    </item>
</selector>
