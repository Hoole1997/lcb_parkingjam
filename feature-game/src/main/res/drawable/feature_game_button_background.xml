<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#D7D9CD" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/feature_game_primary_pressed" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/feature_game_primary" />
            <stroke android:width="1dp" android:color="#E3AC2F" />
            <padding android:left="20dp" android:top="12dp" android:right="20dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
