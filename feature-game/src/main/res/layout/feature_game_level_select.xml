<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 地图区域滚动，顶部与底部操作层保持固定。背景由 LevelSelectView 全屏绘制。 -->
    <ScrollView
        android:id="@+id/feature_game_level_select_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/feature_game_level_select_map_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/feature_game_level_select_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/feature_game_level_select_screen_gutter"
        android:paddingTop="@dimen/feature_game_level_select_header_top_padding"
        android:paddingEnd="@dimen/feature_game_level_select_screen_gutter"
        android:paddingBottom="@dimen/feature_game_level_select_header_bottom_padding">

        <ImageButton
            android:id="@+id/feature_game_level_select_back"
            android:layout_width="@dimen/feature_game_level_select_back_size"
            android:layout_height="@dimen/feature_game_level_select_back_size"
            android:background="@drawable/feature_game_level_select_back_background"
            android:contentDescription="@string/feature_game_level_select_back"
            android:elevation="6dp"
            android:padding="14dp"
            android:src="@drawable/feature_game_level_select_ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/feature_game_level_select_header_height"
            android:layout_marginStart="@dimen/feature_game_level_select_header_gap"
            android:layout_weight="1"
            android:background="@drawable/feature_game_level_select_header_background"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/feature_game_level_select_header_inner_padding"
            android:paddingEnd="@dimen/feature_game_level_select_header_inner_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-rounded"
                android:maxLines="1"
                android:text="@string/feature_game_level_select_chapter"
                android:textColor="@color/feature_game_level_select_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/feature_game_level_select_stars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:drawablePadding="4dp"
                android:fontFamily="sans-serif-rounded"
                android:maxLines="1"
                android:textColor="@color/feature_game_level_select_text_secondary"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/feature_game_level_select_ic_star"
                tools:text="星星 36 / 90" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/feature_game_level_select_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/feature_game_level_select_bottom_scrim"
        android:paddingStart="@dimen/feature_game_level_select_bottom_horizontal_padding"
        android:paddingTop="@dimen/feature_game_level_select_bottom_top_padding"
        android:paddingEnd="@dimen/feature_game_level_select_bottom_horizontal_padding"
        android:paddingBottom="@dimen/feature_game_level_select_bottom_bottom_padding">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/feature_game_level_select_continue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/feature_game_level_select_continue_height"
            android:layout_gravity="center"
            android:background="@drawable/feature_game_level_select_continue_background"
            android:elevation="8dp"
            android:fontFamily="sans-serif-rounded"
            android:maxWidth="@dimen/feature_game_level_select_continue_max_width"
            android:minHeight="@dimen/feature_game_level_select_continue_height"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/feature_game_level_select_cream"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            tools:text="继续第 13 关" />
    </FrameLayout>
</merge>
